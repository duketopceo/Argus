{
  "name": "argus-reviewer-e2e",
  "version": "0.4.2",
  "description": "argus-reviewer — open-source vision-model E2E testing harness. Record, replay, heal, and assert with any OpenRouter model under a hard budget cap.",
  "type": "module",
  "license": "MIT",
  "author": "Luke Kimball",
  "homepage": "https://github.com/duketopceo/Argus#readme",
  "bugs": "https://github.com/duketopceo/Argus/issues",
  "keywords": [
    "e2e-testing",
    "vision-model",
    "playwright",
    "code-review",
    "openrouter",
    "github-actions",
    "ai-testing",
    "byok"
  ],
  "bin": {
    "argus-reviewer": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/api.js",
    "./api": "./dist/api.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "action"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:parity": "esbuild action/parity-entry.mjs --bundle --format=cjs --platform=node --target=node20 --banner:js=\"/* eslint-disable */ /* GENERATED - do not edit; npm run build:parity */\" --outfile=action/parity.cjs",
    "check:parity": "node scripts/check-parity.mjs",
    "check:dist": "test -z \"$(git status --porcelain -- dist/)\" && test -z \"$(git ls-files --others --ignored --exclude-standard -- dist/)\"",
    "test": "vitest run",
    "test:tmp-leaks": "node scripts/check-tmp-leaks.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build && chmod +x dist/cli.js",
    "eval": "node evals/run.mjs",
    "watch": "node scripts/watch.mjs",
    "smoke:dashboard": "node tests/e2e/dashboard-smoke.mjs",
    "app": "electron electron",
    "demo": "node scripts/demo.mjs",
    "demo:record": "node scripts/demo-record.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "brand": "node scripts/build-brand.mjs",
    "render:brand": "node scripts/render-brand.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.2",
    "electron": "^44.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.0.0",
    "svgo": "^4.1.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duketopceo/Argus.git"
  }
}
