{
  "name": "vision-e2e",
  "version": "0.0.1",
  "description": "Open-source, BYOK vision-model E2E testing harness: record once, fingerprint-cache, replay near-free, heal on drift, report on the GitHub PR.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "vision-e2e": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/api.js",
    "./api": "./dist/api.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "action"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "typescript": "^5.5.0"
  }
}
